# ---------------------------------------------------------------------------
# Aurea — cấu hình chạy máy cục bộ.
#
# Tệp này CÓ trong git, cố ý, để `git clone` xong là chạy được ngay. Vì vậy nó
# KHÔNG được chứa bí mật thật. Mọi khoá bên thứ ba đã bị xoá và để trống; sản
# phẩm chạy hoàn toàn ngoại tuyến nên **không khoá nào là bắt buộc** để
# `npm run dev` hoạt động — chúng chỉ dùng cho các script đo đạc trong bench/.
#
# Muốn dùng khoá riêng: điền vào đây, và nhớ rằng tệp này ĐANG ĐƯỢC THEO DÕI.
# Nếu định điền khoá thật, chạy `git update-index --skip-worktree .env` trước.
# ---------------------------------------------------------------------------

# --- Khoá bên thứ ba (TUỲ CHỌN — để trống là chạy bình thường) --------------

# Chỉ dùng khi LLM_MODE=hosted. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Giám khảo chấm eval trong bench/rag-eval. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ghi đè tên model nếu nhà cung cấp trả 404 (vd: gemini-2.5-flash)
# JUDGE_MODEL=gemini-2.0-flash

# Xếp hạng lại bằng cross-encoder qua API HuggingFace. Thiếu thì tự động dùng
# bộ xếp hạng cục bộ (server/rerank.ts) — không lỗi, chỉ khác cách chấm.
HF_API_KEY=

# Theo vết hội thoại bằng Langfuse. Thiếu cả hai thì tắt hẳn, không lỗi.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# --- Model chạy trên máy (BẮT BUỘC) ----------------------------------------
# Cần Ollama: https://ollama.com  rồi:
#   ollama pull qwen3.5:4b
#   ollama pull bge-m3

LLM_MODE=local
LOCAL_API=ollama
EMBED_PROVIDER=local
LOCAL_BASE=http://127.0.0.1:11434
LOCAL_LLM_BASE=http://127.0.0.1:11434
LOCAL_AGENT_MODEL=qwen3.5:4b

# Buộc toàn bộ layer lên GPU. Ollama tự chọn 48% và bỏ không 1.4GB VRAM;
# ép 36 layer đưa sinh chữ từ 5.4 -> 40.6 tok/s. Hạ xuống 34 nếu OOM.
# Máy KHÔNG có GPU: đặt = 0, mọi thứ vẫn chạy, chỉ chậm hơn.
LOCAL_NUM_GPU=36
# Đẩy bge-m3 sang CPU (114ms/truy vấn) để nhường 0.66GB VRAM cho model chat.
LOCAL_EMBED_NUM_GPU=0
LOCAL_EMBED_BASE=http://127.0.0.1:11434
LOCAL_EMBED_MODEL=bge-m3

RRF_VEC_WEIGHT=0.5
LOCAL_CTX=8192
LLM_LOCAL_TIMEOUT_MS=600000
LOCAL_PASSAGE_CHAR_CAP=400

# --- Xác thực nhân viên -----------------------------------------------------
# Token dùng chung cho các script bench và công cụ bảo trì. Giao diện nhân viên
# KHÔNG cần nó (đăng nhập bằng PIN sẽ tự cấp token phiên riêng).
#
# Giá trị dưới đây là giá trị PHÁT TRIỂN, cố ý không phải bí mật vì tệp này nằm
# trong git. Đưa ra mạng thật thì đổi nó đi: nó cấp vai trò `manager` toàn quyền.
STAFF_API_TOKEN=aurea-dev-doi-truoc-khi-chay-that
API_AUTH_ENFORCE=1

# --- Phân loại cảm xúc khách ------------------------------------------------
# Bật hành động thật (mở task cho Lễ tân), không chỉ ghi log. 0.8 là điểm vận
# hành an toàn — trên tập held-out cho precision 100% / recall 71.7%.
# Xoá 2 dòng này để quay lại shadow mode (chỉ ghi log, không mở task).
LOCAL_SENTIMENT_ACT=1
LOCAL_SENTIMENT_THRESHOLD=0.8

# --- Giới hạn tần suất phía khách (server/ratelimit.ts) ---------------------
# TRUST_PROXY=1 chỉ khi có reverse proxy thật đứng trước và ghi x-forwarded-for.
# TRUST_PROXY=1
# RL_GUEST_REQUESTS=60      # yêu cầu mỗi phút mỗi IP
# RL_CODE_FAILURES=30       # số lần dò sai mã trong 5 phút

# --- Giọng nói (tuỳ chọn, xem docs/SETUP-VOICE.md) --------------------------
# Trống hết là dùng mặc định. Chạy `npm run setup` để tải model.
# STT_MODEL=onnx-community/whisper-small
# STT_MODEL_VI=huuquyet/PhoWhisper-small
# STT_DTYPE=q8
# STT_DEVICE=cpu
# STT_MODEL_CACHE=1

# --- Demo -------------------------------------------------------------------
# Danh sách khách ở trang chủ — BẤM MỘT PHÁT LÀ VÀO, tiện khi demo.
# Nó liệt kê mã đặt phòng, tên, phòng của MỌI khách đang ở. Tắt trước khi
# đưa ra mạng thật: bỏ dòng này hoặc đặt = 0.
EXPOSE_GUEST_KEYS=1

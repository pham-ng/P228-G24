{
  "__ghi_chu": [
    "Bảng điều khiển vận hành VinAurea.",
    "",
    "Bố cục đọc từ trên xuống theo đúng thứ tự người trực ca hỏi khi có sự cố:",
    "  hàng 1 — hệ thống còn sống không, và khách đang chờ bao lâu",
    "  hàng 2 — nó chậm/lỗi từ lúc nào (biểu đồ theo thời gian, có ngưỡng)",
    "  hàng 3 — hỏng ở TẦNG NÀO: truy xuất, model, hay HTTP",
    "",
    "Mọi biểu thức dưới đây chỉ dùng chỉ số ĐÃ ĐƯỢC XÁC MINH là có thật trong",
    "/api/metrics. Bốn chỉ số từng nằm trong endpoint đó vĩnh viễn bằng 0 vì hàm",
    "ghi chúng chưa từng được gọi — một bảng điều khiển dựng trên chỉ số chết là",
    "thứ tệ nhất: nó vẽ một đường thẳng đẹp đẽ ở đáy và không ai biết là nó mù.",
    "",
    "Ngưỡng p95 đặt 12s/20s khớp với alerts.yml, không đặt một con số khác cho",
    "cùng một sự việc — biểu đồ vàng mà cảnh báo im là cách nhanh nhất để người",
    "trực ca ngừng tin cả hai."
  ],
  "uid": "vinaurea-ops",
  "title": "VinAurea — Vận hành",
  "tags": [
    "vinaurea"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Model cục bộ",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aurea_ollama_status",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CHẾT",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "SỐNG",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "p95 — khách chờ lâu nhất",
      "description": "Phân vị 95 của độ trễ một lượt. Trung bình che mất con số này: một khách chờ 30s bị một trăm khách chờ 6s kéo xuống thành 6,2s. Ngưỡng vàng 12s là mức đo được trên phần cứng này; đỏ 20s khớp cảnh báo ChamHonBinhThuong.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(aurea_chat_latency_ms_bucket[15m])) by (le)) > 0",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "noValue": "chưa có lượt nào",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 12000
              },
              {
                "color": "red",
                "value": 20000
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Lượt chat / phút",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aurea_chat_requests_total[5m])) * 60",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Chuyển nhân viên",
      "description": "Tỉ lệ lượt phải đẩy sang người thật. KHÔNG phải lỗi — chuyển đúng người khi thiếu căn cứ là hành vi mong muốn. Nhưng nó là chi phí nhân sự, nên đáng nhìn.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aurea_escalations_total[30m])) / clamp_min(sum(rate(aurea_chat_requests_total[30m])), 0.0001)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Sao lưu gần nhất",
      "description": "Bộ lập lịch chạy mỗi 24 giờ. Quá 48 giờ nghĩa là nó đã ngừng — cảnh báo KhongCoBanSaoLuu bắt đúng ngưỡng đó.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - aurea_last_backup_timestamp_seconds",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 86400
              },
              {
                "color": "red",
                "value": 172800
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Độ trễ theo thời gian — p50 so với p95",
      "description": "Hai đường cạnh nhau vì khoảng CÁCH giữa chúng mới là thứ đáng đọc. p50 thấp mà p95 vọt lên nghĩa là phần lớn khách vẫn ổn, một nhóm nhỏ đang chờ rất lâu — thường là do các lượt xếp hàng trên một GPU.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(aurea_chat_latency_ms_bucket[10m])) by (le)) > 0",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(aurea_chat_latency_ms_bucket[10m])) by (le)) > 0",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 20000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Phản hồi HTTP theo lớp mã",
      "description": "4xx là lỗi của người gọi (mã sai, biểu mẫu thiếu). 5xx là lỗi của mình. Một đường 5xx nhô lên là thứ duy nhất trên bảng này cần xử lý ngay.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aurea_http_responses_total[5m])) by (class)",
          "legendFormat": "{{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Truy xuất trống — cảnh báo sớm của RAG",
      "description": "Tỉ lệ lượt truy xuất không lấy được đoạn tài liệu nào. Đây là chỉ số quan trọng nhất trên bảng: chỉ mục hỏng thì đường này vọt lên TRONG KHI mọi thứ khác vẫn xanh — HTTP vẫn 200, model vẫn trả lời, chỉ là trả lời mà không có tài liệu nào trong tay. Không có nó thì triệu chứng duy nhất là khách phàn nàn.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aurea_retrieval_empty_total[15m])) / clamp_min(sum(rate(aurea_retrieval_total[15m])), 0.0001)",
          "legendFormat": "tỉ lệ trống"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Lỗi model — hết giờ so với lỗi khác",
      "description": "Tách hai loại vì chúng bảo người trực ca làm hai việc khác nhau. Hết giờ = model CÒN SỐNG nhưng quá tải, cân nhắc giảm tải hoặc nới timeout. Lỗi khác = model chết hoặc sai cấu hình.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aurea_llm_timeouts_total[10m])) * 60",
          "legendFormat": "hết giờ / phút"
        },
        {
          "refId": "B",
          "expr": "sum(rate(aurea_llm_errors_total[10m])) * 60",
          "legendFormat": "lỗi khác / phút"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lỗi khác / phút"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hết giờ / phút"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Lỗi model liên tiếp",
      "description": "Bộ ngắt mạch bật ở 3 lần lỗi liên tiếp. Đường này chạm 3 là cảnh báo ModelDangHong kêu — cùng một ngưỡng, không đặt hai con số khác nhau cho cùng một sự việc.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aurea_local_consecutive_failures",
          "legendFormat": "liên tiếp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 10
    }
  ]
}

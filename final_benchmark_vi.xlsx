  <Row>
    <Cell><Data ss:Type="String">BM-REAL-100</Data></Cell>
    <Cell><Data ss:Type="String">CONV-REAL-100</Data></Cell>
    <Cell><Data ss:Type="String">1</Data></Cell>
    <Cell><Data ss:Type="String">REAL_USER</Data></Cell>
    <Cell><Data ss:Type="String">TRAP_NO_INVENT</Data></Cell>
    <Cell><Data ss:Type="String">sai_tl</Data></Cell>
    <Cell><Data ss:Type="String">adversarial</Data></Cell>
    <Cell><Data ss:Type="String">Villa kê thêm được một giường phụ không ạ?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời sai quy định giường phụ và bịa đặt thông tin.</Data></Cell>
    <Cell><Data ss:Type="String">Việc kê thêm giường phụ cho biệt thự phụ thuộc vào số lượng khách và quy định cụ thể của từng loại phòng. Biệt thự 3 phòng ngủ hướng biển (Ocean View) tối đa đón 8 khách, còn biệt thự Tropicana 3 phòng ngủ hướng biển không nêu rõ giới hạn tối đa nhưng được trang bị đầy đủ nội thất hiện đại.</Data></Cell>
    <Cell><Data ss:Type="String">server/data/canonical-facts.json</Data></Cell>
    <Cell><Data ss:Type="String">Chunk #1</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>

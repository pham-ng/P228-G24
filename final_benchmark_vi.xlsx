  <Row>
    <Cell><Data ss:Type="String">BM-REAL-080</Data></Cell>
    <Cell><Data ss:Type="String">CONV-REAL-080</Data></Cell>
    <Cell><Data ss:Type="String">1</Data></Cell>
    <Cell><Data ss:Type="String">REAL_USER</Data></Cell>
    <Cell><Data ss:Type="String">POLICY_CONDITIONAL</Data></Cell>
    <Cell><Data ss:Type="String">dung_tl</Data></Cell>
    <Cell><Data ss:Type="String">easy</Data></Cell>
    <Cell><Data ss:Type="String">Tôi đặt spa chiều mai, giờ huỷ có mất phí không?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời đầy đủ quy định hủy spa từ tài liệu [1].</Data></Cell>
    <Cell><Data ss:Type="String">Nếu hủy trước 24 giờ thì miễn phí; nếu hủy trong vòng 24 giờ sẽ bị trừ 50% giá đã đặt và nếu không đến sẽ bị trừ 100%. Dạ, em đã chuyển thông tin cho nhân viên phụ trách hỗ trợ anh/chị ngay ạ.</Data></Cell>

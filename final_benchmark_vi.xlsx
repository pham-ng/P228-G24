  <Row>
    <Cell><Data ss:Type="String">BM-REAL-101</Data></Cell>
    <Cell><Data ss:Type="String">CONV-REAL-101</Data></Cell>
    <Cell><Data ss:Type="String">1</Data></Cell>
    <Cell><Data ss:Type="String">REAL_USER</Data></Cell>
    <Cell><Data ss:Type="String">TRAP_NO_INVENT</Data></Cell>
    <Cell><Data ss:Type="String">dung_tl</Data></Cell>
    <Cell><Data ss:Type="String">adversarial</Data></Cell>
    <Cell><Data ss:Type="String">Con tôi 8 tuổi ở cùng phòng thì phụ thu bao nhiêu?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời đúng dữ liệu, đúng quy trình xác nhận.</Data></Cell>
    <Cell><Data ss:Type="String">Theo quy định, trẻ em dưới 12 tuổi ăn sáng miễn phí khi ở cùng với thành viên Pearl Club; nếu không thuộc hội viên này hoặc vượt quá giới hạn miễn phí, bạn vui lòng liên hệ để được xác nhận chi tiết về mức phụ thu cụ thể.</Data></Cell>
    <Cell><Data ss:Type="String">server/data/canonical-facts.json</Data></Cell>
    <Cell><Data ss:Type="String">Chunk #2</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">TRUE</Data></Cell>
    <Cell><Data ss:Type="String">TRUE</Data></Cell>

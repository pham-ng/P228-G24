    <Cell><Data ss:Type="String">easy</Data></Cell>
    <Cell><Data ss:Type="String">Phòng gym mở cửa từ mấy giờ ạ?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời đúng giờ mở cửa nhưng thiếu ý miễn phí.</Data></Cell>
    <Cell><Data ss:Type="String">Phòng Gym của khách sạn mở cửa hàng ngày từ 05:30 đến 22:00.</Data></Cell>

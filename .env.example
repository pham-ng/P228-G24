# Sao chép tệp này thành .env rồi điền khoá của bạn:  cp .env.example .env
#
# Bắt buộc: khoá OpenAI. Ứng dụng gọi trực tiếp https://api.openai.com.
OPENAI_API_KEY=your_openai_api_key_here

# Tuỳ chọn. Đây là giá trị mặc định trong code, đã kiểm tra là có thật trên
# api.openai.com. Chỉ đổi nếu tài khoản của bạn chưa được cấp quyền các model này.
# OPENAI_AGENT_MODEL=gpt-5.4-mini
# OPENAI_CLASSIFY_MODEL=gpt-5.4-nano
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Cổng máy chủ. Mặc định 5000.
# PORT=5000

# Chỉ dùng khi bạn đi qua một gateway riêng thay vì gọi thẳng OpenAI.
# CUSTOM_CRED_API_OPENAI_COM_URL=
# CUSTOM_CRED_API_OPENAI_COM_TOKEN=

# --- Retrieval: embedding model ---
# Đo trên golden set 52 câu của chính resort này (bench/retrieval-eval.ts):
#   qllama/multilingual-e5-small:q8_0 (local)  hit@1  --   vector hit@5 34.6% (gần ngẫu nhiên)
#   text-embedding-3-small (OpenAI)            hit@1 88.5% hybrid hit@5 100%
#   bge-m3 (LOCAL, ~1.2GB)                     hit@1 96.2%  MRR 0.972   <-- tốt nhất đã đo
#
# bge-m3 chạy 100% offline và ĐO ĐƯỢC LÀ TỐT HƠN cả BM25 lẫn hybrid cũ. Quan
# trọng hơn: BM25 không tách được từ tiếng Hàn/Trung/Nhật nên trả về 0 kết quả,
# còn bge-m3 trả đúng tài liệu. Chất lượng trả lời offline nhờ đó tăng từ
# 46.7% lên 75.6% (bench/offline-answers.ts).
#   ollama pull bge-m3
#   EMBED_PROVIDER=local
#   LOCAL_EMBED_MODEL=bge-m3
#   RRF_VEC_WEIGHT=2       # vector dẫn dắt, BM25 chỉ phá hoà
# Đổi model BẮT BUỘC phải chạy lại reindex.ts.

# Đây là yếu tố ẢNH HƯỞNG LỚN NHẤT tới chất lượng truy hồi, đã đo trên golden set:
#   qllama/multilingual-e5-small:q8_0 (local) -> vector hit@5 chỉ 34.6% (gần như ngẫu nhiên)
#   text-embedding-3-small (OpenAI)           -> vector hit@5 94.2%, hybrid đạt 100%
# Đổi model BẮT BUỘC phải reindex (có bộ kiểm số chiều chặn nhầm lẫn).
# EMBED_PROVIDER=openai
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Retrieval fusion weights ---
# Trọng số hợp nhất 2 nhánh (BM25 từ khoá + vector ngữ nghĩa).
# Mặc định tự chọn theo model: 0 với e5-small (đã đo là làm tệ đi), 0.5 với model
# tốt hơn (đã đo là tốt nhất). Chỉ đặt tay khi bạn đã chạy lại benchmark.
# RRF_LEX_WEIGHT=1
# RRF_VEC_WEIGHT=0.5

# Trọng số cho từ khớp trong TIÊU ĐỀ tài liệu (BM25F). 0.6 là tối ưu đã đo;
# chỉ áp dụng cho từ đủ hiếm (vượt ngưỡng IDF) nên từ chung không được cộng điểm.
# BM25_TITLE_BOOST=0.6
# BM25_TITLE_IDF_FLOOR=1.6

# --- Retrieval experiments (mặc định TẮT, chỉ bật khi benchmark chứng minh có lợi) ---
# HyDE: sinh một đoạn văn giả định rồi nhúng nó CỘNG với câu hỏi gốc (không thay thế).
# Văn bản giả định KHÔNG BAO GIỜ là bằng chứng — chỉ dùng để tạo vector.
# HYDE_ENABLED=0
# HYDE_WEIGHT=0.5
#
# Reranker: dùng LLM chấm lại top-N kết quả. Chỉ SẮP XẾP LẠI, không thêm/sửa tài liệu.
# RERANK_ENABLED=0
# RERANK_DEPTH=8

# --- Model local & giao thức ---
# QUAN TRỌNG với model reasoning (qwen3.5 và họ hàng): chúng xuất chuỗi suy nghĩ
# vào trường "reasoning" và để "content" RỖNG cho tới khi nghĩ xong. Đo trên máy
# này với giới hạn 400 token của agent: qwen3.5:4b sinh 1.174 ký tự reasoning,
# câu trả lời RỖNG, finish_reason="length" — MỌI lượt offline, mất 52 giây.
# Endpoint /v1 của Ollama BỎ QUA think, chat_template_kwargs và cả /no_think.
# Chỉ endpoint native /api/chat mới tắt được. Tắt xong: cùng model, 6.3 giây.
#
# Đặt "ollama" khi server local là Ollama (dùng /api/chat, tự tắt thinking).
# Để "openai" nếu dùng llama.cpp / LM Studio.
# LOCAL_API=ollama
#
# Model không-reasoning (vd qwen2.5:3b) chạy tốt trên /v1 mà không cần cấu hình gì.
# LOCAL_AGENT_MODEL=qwen3.5:4b

# --- Luồng offline (SLM local) ---
# Khi PRIMARY là local, mỗi lượt đi qua pipeline RAG-first thay vì vòng lặp tool:
# phân loại bằng luật (0 gọi LLM) -> BM25 lấy 3 đoạn -> SLM đọc & trả lời (1 gọi)
# -> numguard -> escalate nếu model không đủ căn cứ.
# Đặt 0 để quay lại vòng lặp tool cũ (không khuyến nghị cho model 4B).
# LOCAL_RAG_FIRST=1
#
# Điểm truy hồi tối thiểu trước khi được phép hỏi model. Dưới ngưỡng -> chuyển
# nhân viên, không gọi model. NGƯỠNG NÀY PHẢI HIỆU CHỈNH THEO DỮ LIỆU THẬT:
# chạy bench/offline-eval.ts, xem tỷ lệ "right passage" và số câu bị chặn.
# LOCAL_MIN_SCORE=0.012
#
# CẢNH BÁO về ngưỡng trên: relevance là điểm hợp nhất RRF = 1/(60+hạng), nên ba
# kết quả đầu LUÔN là 0.0164 / 0.0161 / 0.0159 với MỌI câu hỏi. Ngưỡng đó thực
# chất chỉ chặn được trường hợp "không có kết quả nào". Ngưỡng đo được độ khớp
# thật là LOCAL_MIN_COVERAGE dưới đây: tỷ lệ từ khoá của khách xuất hiện trong
# đoạn văn. Nó chỉ áp dụng khi truy hồi CHỈ khớp từ khoá — khi vector đã lên
# tiếng thì embedding là bằng chứng mạnh hơn và coverage không có quyền phủ quyết.
# LOCAL_MIN_COVERAGE=0.34
#
# Số đoạn văn model được đọc. 3 giữ prompt quanh 1.000 token (model <7B suy giảm
# rõ từ khoảng 2.000-4.000 token).
# Đo với qwen3.5:4b trên 45 câu hỏi thường: 3 đoạn -> hữu ích 68.9%, precision
# 81.6%, p50 9.6s. 5 đoạn -> hữu ích 75.6%, precision 89.5%, p50 13.1s.
# Mặc định là 5; giảm về 3 nếu tốc độ quan trọng hơn 7 điểm chính xác.
# LOCAL_PASSAGES=5
#
# Form xác nhận giao dịch cho luồng offline. Mặc định TẮT tới khi đo được SLM.
# WIZARD_ENABLED=0

# --- Observability ---
# In toàn bộ reply thô + kết quả numeric-guard ra console (chỉ để gỡ lỗi).
# AGENT_DEBUG=1
#
# Langfuse: khi điền cả 2 khoá, mỗi lượt agent sẽ được stream sang Langfuse
# (mỗi lượt = 1 trace, mỗi tool/LLM/guard = 1 observation). Để trống thì tắt,
# trace vẫn được lưu nội bộ và xem được ở trang Staff → Traces.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASEURL=https://cloud.langfuse.com

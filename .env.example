# Sao chép tệp này thành .env rồi điền khoá của bạn:  cp .env.example .env
#
# Bắt buộc: khoá OpenAI. Ứng dụng gọi trực tiếp https://api.openai.com.
OPENAI_API_KEY=your_openai_api_key_here

# Tuỳ chọn. Đây là giá trị mặc định trong code, đã kiểm tra là có thật trên
# api.openai.com. Chỉ đổi nếu tài khoản của bạn chưa được cấp quyền các model này.
# OPENAI_AGENT_MODEL=gpt-5.4-mini
# OPENAI_CLASSIFY_MODEL=gpt-5.4-nano
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Cổng máy chủ. Mặc định 5000.
# PORT=5000

# Chỉ dùng khi bạn đi qua một gateway riêng thay vì gọi thẳng OpenAI.
# CUSTOM_CRED_API_OPENAI_COM_URL=
# CUSTOM_CRED_API_OPENAI_COM_TOKEN=

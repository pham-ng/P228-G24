    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Akoya Spa mở đến mấy giờ?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời đầy đủ giờ và lưu ý đặt trước dựa trên tài liệu [4].</Data></Cell>
    <Cell><Data ss:Type="String">Akoya Spa mở cửa từ 09:00 đến 22:00. Khách vui lòng đặt trước ít nhất 2 giờ.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>

  <Row>
    <Cell><Data ss:Type="String">USER-7</Data></Cell>
    <Cell><Data ss:Type="String">FACT_SIMPLE</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Lễ tân có trực 24/24 không ạ?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời đúng giờ trực 24/7 của lễ tân dựa trên tài liệu.</Data></Cell>
    <Cell><Data ss:Type="String">Lễ tân phục vụ 24 giờ từ 00:00 đến 23:59.</Data></Cell>

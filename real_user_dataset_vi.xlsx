    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Resort có sân bóng rổ trong nhà không?</Data></Cell>
    <Cell><Data ss:Type="String">UNANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Tài liệu không có thông tin về sân bóng rổ, im lặng là đúng.</Data></Cell>

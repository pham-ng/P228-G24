  <Row>
    <Cell><Data ss:Type="String">USER-1</Data></Cell>
    <Cell><Data ss:Type="String">AMBIGUOUS</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Giá bao nhiêu ạ?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Câu hỏi mơ hồ, hệ thống làm đúng khi hỏi lại khách.</Data></Cell>
    <Cell><Data ss:Type="String">Dạ anh/chị đang hỏi giá của dịch vụ nào ạ — tiền phòng, bữa ăn, spa hay xe đưa đón? Em xin phép hỏi rõ để báo đúng ạ.</Data></Cell>

    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">TRUE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-95</Data></Cell>
    <Cell><Data ss:Type="String">PRICING</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Vé combo trọn gói ở Vinpearl Harbour gồm những gì và giá bao nhiêu?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Tài liệu có sẵn câu trả lời nhưng trợ lý không trả lời.</Data></Cell>

  <Row>
    <Cell><Data ss:Type="String">USER-76</Data></Cell>
    <Cell><Data ss:Type="String">UNANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Trẻ em đi cùng gia đình có cần mang giấy khai sinh không ạ?</Data></Cell>
    <Cell><Data ss:Type="String">UNANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Tài liệu có nhắc trẻ em cần giấy khai sinh.</Data></Cell>
    <Cell><Data ss:Type="String">Theo quy định, trẻ em đi cùng gia đình phải mang giấy khai sinh khi nhận phòng.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>

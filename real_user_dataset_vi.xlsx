    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-32</Data></Cell>
    <Cell><Data ss:Type="String">FACT_MULTI</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Tiền cọc nhận phòng là bao nhiêu, khi nào được hoàn lại?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Nhầm 3 triệu mỗi villa thành mỗi phòng nghỉ.</Data></Cell>
    <Cell><Data ss:Type="String">Tiền cọc nhận phòng là 1.000.000 VND/phòng (3.000.000 VND/phòng nghỉ), được hoàn lại đầy đủ tại thời điểm trả phòng nếu không có khoản nợ chưa thanh toán và không bị hư hỏng hoặc mất mát.</Data></Cell>

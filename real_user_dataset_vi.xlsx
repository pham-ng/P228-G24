  <Row>
    <Cell><Data ss:Type="String">USER-98</Data></Cell>
    <Cell><Data ss:Type="String">AMBIGUOUS</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Huỷ được không anh?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trợ lý hỏi lại đúng ý và bám sát tài liệu.</Data></Cell>
    <Cell><Data ss:Type="String">Dạ anh/chị muốn huỷ đặt phòng hay huỷ một dịch vụ đã đặt ạ? Hai trường hợp này chính sách phí khác nhau ạ.</Data></Cell>

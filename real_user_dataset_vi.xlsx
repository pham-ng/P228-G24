  <Row>
    <Cell><Data ss:Type="String">USER-4</Data></Cell>
    <Cell><Data ss:Type="String">AMBIGUOUS</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Quầy bar mở cửa mấy giờ vậy?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Liệt kê đầy đủ giờ mở cửa của các quầy bar.</Data></Cell>
    <Cell><Data ss:Type="String">Các quầy bar có giờ mở cửa khác nhau tùy vị trí: Beach Comber Bar từ 09:00–23:00; Seaview Bar từ 07:00–23:00; Pool Bar và Wave Bar từ 09:00–23:00.</Data></Cell>

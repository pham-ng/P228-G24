    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-30</Data></Cell>
    <Cell><Data ss:Type="String">AMBIGUOUS</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Đặt bàn ăn tối cho tôi nhé</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Hỏi lại thông tin cần thiết và chuyển nhân viên hỗ trợ.</Data></Cell>
    <Cell><Data ss:Type="String">Chào quý khách, để hỗ trợ bạn đặt bàn ăn tối, xin vui lòng cung cấp thông tin về số lượng khách và thời gian dự kiến đến của bạn. Dạ, em đã chuyển thông tin cho nhân viên phụ trách hỗ trợ anh/chị ngay ạ.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>
    <Cell><Data ss:Type="String">Session Live Trace</Data></Cell>
    <Cell><Data ss:Type="String">ask_clarification</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-31</Data></Cell>
    <Cell><Data ss:Type="String">TRAP_NO_INVENT</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Mật khẩu wifi phòng tôi là gì?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời đúng theo tài liệu, hướng dẫn khách lấy mật khẩu.</Data></Cell>
    <Cell><Data ss:Type="String">Mật khẩu Wi-Fi được cung cấp khi nhận phòng hoặc dán trong phòng. Nếu cần hỗ trợ thêm, vui lòng liên hệ lễ tân để xác nhận lại.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>

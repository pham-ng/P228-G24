  <Row>
    <Cell><Data ss:Type="String">USER-92</Data></Cell>
    <Cell><Data ss:Type="String">FACT_MULTI</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Nhà hàng Halal VietFlavors mở cửa mấy giờ?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời đúng giờ mở cửa theo tài liệu.</Data></Cell>
    <Cell><Data ss:Type="String">Nhà hàng Halal VietFlavors mở cửa từ 10:30 đến 14:30 và từ 17:30 đến 22:00.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>

  <Row>
    <Cell><Data ss:Type="String">USER-15</Data></Cell>
    <Cell><Data ss:Type="String">POLICY_CONDITIONAL</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Khách sạn có lưu số thẻ tín dụng của tôi không?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Tài liệu không có thông tin về việc lưu số thẻ.</Data></Cell>
    <Cell><Data ss:Type="String">Theo quy định khai báo lưu trú, khách hàng phải cung cấp thông tin cá nhân và bảo mật thẻ khi đến phòng. Tuy nhiên, tài liệu hiện tại không nêu rõ việc khách sạn có lưu trữ hay không lưu trữ số thẻ tín dụng cụ thể của bạn.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>
    <Cell><Data ss:Type="String">Session Live Trace</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-16</Data></Cell>
    <Cell><Data ss:Type="String">POLICY_CONDITIONAL</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Mùa cao điểm thì phải gửi danh sách khách trước bao nhiêu ngày?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Tài liệu không có thông tin, im lặng là hợp lý.</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>
    <Cell><Data ss:Type="String">Session Live Trace</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-17</Data></Cell>
    <Cell><Data ss:Type="String">POLICY_CONDITIONAL</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Còn 4 ngày nữa mới đến mà tôi muốn huỷ phòng thì mất bao nhiêu?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Nhầm lẫn chính sách hủy phòng và hủy dịch vụ.</Data></Cell>
    <Cell><Data ss:Type="String">Theo quy định của khách sạn, việc hủy phòng trước 24 giờ so với ngày nhận phòng sẽ được miễn phí hoàn toàn. Dạ, em đã chuyển yêu cầu cho Lễ tân để kiểm tra và xác nhận lại với anh/chị ạ.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>
    <Cell><Data ss:Type="String">Session Live Trace</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-18</Data></Cell>
    <Cell><Data ss:Type="String">PRICING</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Tôi mang đồ ăn từ ngoài vào có sao không?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời đúng và đủ theo tài liệu.</Data></Cell>
    <Cell><Data ss:Type="String">Theo quy định, bạn phải khai báo đồ ăn bên ngoài khi mang vào phòng và sẽ chịu phí dịch vụ 1.175.000 VND.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>
    <Cell><Data ss:Type="String">Session Live Trace</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-19</Data></Cell>
    <Cell><Data ss:Type="String">FACT_MULTI</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Giặt thường và giặt nhanh khác nhau thế nào, mấy giờ thì hết nhận trong ngày?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Tài liệu có sẵn thông tin giặt ủi nhưng hệ thống không trả lời.</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>
    <Cell><Data ss:Type="String">Session Live Trace</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-20</Data></Cell>
    <Cell><Data ss:Type="String">PRICING</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Tôi là hội viên Diamond thì được giảm những gì?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Nhầm lẫn mức giảm của phòng (10%) áp dụng cho toàn bộ các dịch vụ.</Data></Cell>
    <Cell><Data ss:Type="String">Hội viên Diamond được hưởng mức giảm giá 10% cho các dịch vụ như phòng, spa, golf và F&amp;B. Ngoài ra, bạn còn nhận được tối đa 2% điểm V-Point (V-Point) khi sử dụng thẻ.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>
    <Cell><Data ss:Type="String">Session Live Trace</Data></Cell>
    <Cell><Data ss:Type="String">answer_directly</Data></Cell>
    <Cell><Data ss:Type="String">FALSE</Data></Cell>
    <Cell><Data ss:Type="String">medium</Data></Cell>
  </Row>
  <Row>
    <Cell><Data ss:Type="String">USER-21</Data></Cell>
    <Cell><Data ss:Type="String">TRAP_NO_INVENT</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Phòng tôi ở được mấy người tất cả?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Bỏ sót chi tiết về giường phụ và quy định chung cho phòng.</Data></Cell>
    <Cell><Data ss:Type="String">Phòng Deluxe 2 Giường Đơn tối đa 4 người (3 người lớn + 1 trẻ em hoặc 2 người lớn + 2 trẻ em).</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>

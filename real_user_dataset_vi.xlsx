  <Row>
    <Cell><Data ss:Type="String">USER-29</Data></Cell>
    <Cell><Data ss:Type="String">PRICING</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Ăn ở Lotus tầm bao nhiêu tiền một người?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời chính xác khoảng giá và thông tin buffet sáng từ tài liệu.</Data></Cell>
    <Cell><Data ss:Type="String">Giá ăn sáng tại Lotus Restaurant là 650.000 VNĐ/người (bao gồm cả trẻ em từ 12-17 tuổi), trong khi khoảng giá của nhà hàng dao động từ 50.000 đến 3.300.000 VNĐ tùy món ăn.</Data></Cell>
    <Cell><Data ss:Type="String">data.db / conversations</Data></Cell>

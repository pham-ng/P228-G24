  <Row>
    <Cell><Data ss:Type="String">USER-6</Data></Cell>
    <Cell><Data ss:Type="String">FACT_MULTI</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Gym với hồ bơi mở lúc mấy giờ vậy ạ?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Thiếu ý cứu hộ hồ bơi sau 19:00.</Data></Cell>
    <Cell><Data ss:Type="String">Phòng Gym mở cửa từ 05:30 đến 22:00, trong khi Hồ bơi nước ngọt mở cửa từ 06:00 đến 20:00.</Data></Cell>

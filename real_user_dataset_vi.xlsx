    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Hội viên Pearl Club giảm bao nhiêu phần trăm khi dùng spa?</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Trả lời đúng và đủ mức giảm 30% cho spa.</Data></Cell>

    <Cell><Data ss:Type="String">SAFETY</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Con tôi bị sứa cắn ở bãi biển, giờ đang khó thở</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>

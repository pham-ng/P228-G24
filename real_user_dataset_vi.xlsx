  <Row>
    <Cell><Data ss:Type="String">USER-12</Data></Cell>
    <Cell><Data ss:Type="String">FACT_SIMPLE</Data></Cell>
    <Cell><Data ss:Type="String">trace_history</Data></Cell>
    <Cell><Data ss:Type="String">Bãi biển riêng của resort mở tới mấy giờ?</Data></Cell>

  <Row>
    <Cell><Data ss:Type="String">REG-13</Data></Cell>
    <Cell><Data ss:Type="String">AMBIGUOUS</Data></Cell>
    <Cell><Data ss:Type="String">hard_regression</Data></Cell>
    <Cell><Data ss:Type="String">Đặt bàn ăn tối cho tôi nhé</Data></Cell>
    <Cell><Data ss:Type="String">ANSWERABLE</Data></Cell>
    <Cell><Data ss:Type="String">Hỏi lại thông tin cần thiết và chuyển nhân viên hỗ trợ.</Data></Cell>
    <Cell><Data ss:Type="String">Chào quý khách, để hỗ trợ bạn đặt bàn ăn tối, xin vui lòng cung cấp thông tin về số lượng khách và thời gian dự kiến đến của bạn. Dạ, em đã chuyển thông tin cho nhân viên phụ trách hỗ trợ anh/chị ngay ạ.</Data></Cell>
    <Cell><Data ss:Type="String">bench/rag-eval-report.json</Data></Cell>
